  <script>
    // ── Language System ──────────────────────────────────────────
    const i18n = {
      en: {
        'faq.hero.title': 'Frequently Asked Questions',
        'faq.hero.sub': 'Professional cat tree OEM/ODM manufacturer — your complete FAQ guide',
        'faq.stat1': 'Q&A Topics',
        'faq.stat2': 'Categories',
        'faq.stat3': 'Response Time',
        'faq.cta.title': 'Still Have Questions?',
        'faq.cta.sub': 'Our international sales team is ready to help',
        'faq.cta.btn': 'Contact Us Now',
        'faq.hero.badge': 'Help Center',
        'tab.all': '全部',
        'section.工厂实力与资质': '🏭 Factory & Credentials',
        'section.产品与定制服务': '📦 Products & Customization',
        'section.质量控制与测试': '🔧 Quality Control',
        'section.生产与物流': '🚛 Production & Logistics',
        'section.商务条款与合作': '💰 Business & Cooperation',
        'section.出口服务与认证': '🌍 Export & Certification',
        'section.市场信息与趋势': '📊 Market Insights',
        'section.合作流程与联系方式': '🤝 Cooperation & Contact',
      },
      zh: {},
      es: { 'faq.hero.title': 'Preguntas Frecuentes', 'faq.hero.sub': 'Fabricante profesional de árboles para gatos OEM/ODM', 'faq.stat1': 'Temas', 'faq.stat2': 'Categorías', 'faq.stat3': 'Respuesta', 'faq.cta.title': '¿Otras preguntas?', 'faq.cta.sub': 'Nuestro equipo de ventas está listo para ayudar', 'faq.cta.btn': 'Contáctenos' },
      fr: { 'faq.hero.title': 'Questions Fréquentes', 'faq.hero.sub': 'Fabricant professionnel OEM/ODM d\'arbres à chat', 'faq.stat1': 'Sujets', 'faq.stat2': 'Catégories', 'faq.stat3': 'Réponse', 'faq.cta.title': 'D\'autres questions?', 'faq.cta.sub': 'Notre équipe commerciale est prête à vous aider', 'faq.cta.btn': 'Contactez-nous' },
      de: { 'faq.hero.title': 'Häufige Fragen', 'faq.hero.sub': 'Professioneller Katzenbaum OEM/ODM Hersteller', 'faq.stat1': 'Themen', 'faq.stat2': 'Kategorien', 'faq.stat3': 'Antwort', 'faq.cta.title': 'Weitere Fragen?', 'faq.cta.sub': 'Unser Vertriebsteam hilft gerne', 'faq.cta.btn': 'Kontakt' },
      ja: { 'faq.hero.title': 'よくある質問', 'faq.hero.sub': 'プロフェッショナルなキャットツリーOEM/ODMメーカー', 'faq.stat1': 'トピック', 'faq.stat2': 'カテゴリー', 'faq.stat3': '応答', 'faq.cta.title': '他にご質問は?', 'faq.cta.sub': '営業チームがいつでもお手伝いします', 'faq.cta.btn': 'お問い合わせ' },
      ko: { 'faq.hero.title': '자주 묻는 질문', 'faq.hero.sub': '전문 고양이 스크래치 트리 OEM/ODM 제조업체', 'faq.stat1': '주제', 'faq.stat2': '카테고리', 'faq.stat3': '응답', 'faq.cta.title': '다른 질문이 있으신가요?', 'faq.cta.sub': '영업팀이 언제든지 도와드리겠습니다', 'faq.cta.btn': '문의하기' },
    };

    // ── Hamburger ───────────────────────────────────────────────
    const hamburger = document.getElementById('hamburger');
    const nav = document.getElementById('nav');
    hamburger.addEventListener('click', function() {
      this.classList.toggle('open');
      nav.classList.toggle('mobile-open');
    });

    // ── Language Switcher ───────────────────────────────────────
    const langBtn = document.getElementById('langBtn');
    const langDropdown = document.getElementById('langDropdown');
    langBtn.addEventListener('click', function(e) { e.stopPropagation(); langDropdown.style.display = langDropdown.style.display === 'block' ? 'none' : 'block'; });
    document.addEventListener('click', function() { langDropdown.style.display = 'none'; });

    // Read SSR-injected lang, fallback to 'en'
    let currentLang = (typeof __SSR_LANG__ !== 'undefined' ? __SSR_LANG__ : 'en');
    function setLang(lang) {
      currentLang = lang;
      langBtn.textContent = lang.toUpperCase();
      langDropdown.style.display = 'none';
      applyI18n();
      loadFAQs();
    }

    function applyI18n() {
      document.querySelectorAll('[data-i18n]').forEach(function(el) {
        const key = el.getAttribute('data-i18n');
        if (i18n[currentLang] && i18n[currentLang][key]) {
          el.textContent = i18n[currentLang][key];
        }
      });
      // Update tab labels (data-key = Chinese section key, display = i18n text)
      document.querySelectorAll('.faq-tab[data-key]').forEach(function(tab) {
        var key = tab.getAttribute('data-key');
        if (key === '') {
          tab.textContent = '全部 / All';
        } else {
          var sectionKey = 'section.' + key;
          tab.textContent = (i18n[currentLang] && i18n[currentLang][sectionKey]) || key;
        }
      });
    }

    // ── FAQ Data & Render ───────────────────────────────────────
    const SECTION_ORDER = [
      '工厂实力与资质','产品与定制服务','质量控制与测试',
      '生产与物流','商务条款与合作','出口服务与认证',
      '市场信息与趋势','合作流程与联系方式'
    ];

    const SECTION_ICONS = {
      '工厂实力与资质': '🏭','产品与定制服务': '📦',
      '质量控制与测试': '🔧','生产与物流': '🚛',
      '商务条款与合作': '💰','出口服务与认证': '🌍',
      '市场信息与趋势': '📊','合作流程与联系方式': '🤝',
      'Factory Strength & Credentials': '🏭','Products & Customization': '📦',
      'Quality Control & Testing': '🔧','Production & Logistics': '🚛',
      'Business Terms & Cooperation': '💰','Export Services & Certification': '🌍',
      'Market Insights & Trends': '📊','Cooperation Process & Contact': '🤝',
    };

    function getSectionTitle(section) {
      var sectionKey = 'section.' + section;
      return (i18n[currentLang] && i18n[currentLang][sectionKey]) || section || '其他';
    }

    // ── Section Order & Icons (language-aware) ────────────────────
    function getSectionOrder(lang) {
      if (lang === 'en') {
        return [
          'Factory Strength & Credentials',
          'Products & Customization',
          'Quality Control & Testing',
          'Production & Logistics',
          'Business Terms & Cooperation',
          'Export Services & Certification',
          'Market Insights & Trends',
          'Cooperation Process & Contact'
        ];
      }
      return [
        '工厂实力与资质','产品与定制服务','质量控制与测试',
        '生产与物流','商务条款与合作','出口服务与认证',
        '市场信息与趋势','合作流程与联系方式'
      ];
    }

    function groupBySection(faqs, lang) {
      var order = getSectionOrder(lang);
      var groups = {};
      order.forEach(function(s) { groups[s] = []; });
      faqs.forEach(function(f) {
        var s = f.section || '';
        if (!groups[s]) groups[s] = [];
        groups[s].push(f);
      });
      Object.keys(groups).forEach(function(k) {
        if (groups[k].length === 0) delete groups[k];
      });
      return groups;
    }

    function renderFAQ(groups, filterSection) {
      var order = getSectionOrder(currentLang);
      var html = '';
      var sections = filterSection ? { [filterSection]: groups[filterSection] || [] } : groups;
      var idx = 0;
      for (var section in sections) {
        var items = sections[section];
        if (!items || items.length === 0) continue;
        var icon = SECTION_ICONS[section] || '📋';
        html += '<div class="faq-section">';
        html += '<div class="faq-section-header">';
        html += '<span class="faq-section-icon">' + icon + '</span>';
        html += '<h2 class="faq-section-title">' + getSectionTitle(section) + '</h2>';
        html += '</div>';
        items.forEach(function(item) {
          idx++;
          var num = String(idx).padStart(2, '0');
          html += '<div class="faq-card" data-section="' + section + '">';
          html += '<div class="faq-q" onclick="toggleFaq(this)">';
          html += '<span class="q-num">' + num + '</span>';
          html += '<span class="q-text">' + (item.question || '') + '</span>';
          html += '<span class="q-toggle">+</span>';
          html += '</div>';
          html += '<div class="faq-a"><div class="faq-a-inner">' + (item.answer || '') + '</div></div>';
          html += '</div>';
        });
        html += '</div>';
      }
      return html || '<p style="text-align:center;color:#94a3b8;padding:60px;">暂无FAQ内容</p>';
    }

    function toggleFaq(el) {
      var card = el.closest('.faq-card');
      console.log('点击问题, card:', card);
      var wasOpen = card.classList.contains('open');
      console.log('之前是否打开:', wasOpen);
      // Close all in same section
      document.querySelectorAll('.faq-card').forEach(function(c) { c.classList.remove('open'); });
      if (!wasOpen) {
        card.classList.add('open');
        console.log('添加open类');
        // 检查答案区域
        var answerDiv = card.querySelector('.faq-a');
        var answerInner = card.querySelector('.faq-a-inner');
        console.log('答案区域:', answerDiv);
        console.log('答案内容:', answerInner ? answerInner.textContent.substring(0, 50) + '...' : '未找到');
      }
    }

    let allFAQs = [];

    // ── FAQPage JSON-LD ──────────────────────────────────────────
    function injectFAQJsonLd(faqs) {
      if (!faqs || !faqs.length) return;
      var lang = currentLang || 'zh';
      var faqItems = faqs.map(function(f) {
        return {
          "@type": "Question",
          "name": f.question || f.question_en || '',
          "acceptedAnswer": {
            "@type": "Answer",
            "text": f.answer || f.answer_en || ''
          }
        };
      });
      var ldData = {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems
      };
      var el = document.getElementById('faq-ldjson');
      if (el) el.textContent = JSON.stringify(ldData);
    }

    async function loadFAQs() {
      var el = document.getElementById('faqContent');
      el.innerHTML = '<div class="faq-loading">加载中</div>';
      try {
        var res = await fetch('/api/site/faqs?lang=' + currentLang + '&t=' + Date.now());
        if (!res.ok) throw new Error('fetch failed');
        allFAQs = await res.json();
        console.log('FAQ数据加载成功:', allFAQs.length, '条');
        console.log('第一条FAQ:', allFAQs[0]);
        var groups = groupBySection(allFAQs, currentLang);
        console.log('分组结果:', groups);
        var renderedHtml = renderFAQ(groups, currentFilter);
        console.log('渲染HTML长度:', renderedHtml.length);
        // 调试：检查渲染的HTML是否包含答案
        if (renderedHtml.includes('faq-a-inner')) {
          console.log('✅ 渲染HTML包含答案区域');
        } else {
          console.log('❌ 渲染HTML不包含答案区域');
        }
        el.innerHTML = renderedHtml;
        console.log('渲染完成');

        // 注入 FAQPage JSON-LD 结构化数据
        injectFAQJsonLd(allFAQs);
      } catch(e) {
        console.error('加载失败:', e);
        el.innerHTML = '<p style="text-align:center;color:#ef4444;padding:40px;">加载失败: ' + e.message + '</p>';
      }
    }

    // Tab Filter ───────────────────────────────────────────────
    var currentFilter = '';
    document.getElementById('faqTabs').addEventListener('click', function(e) {
      if (!e.target.classList.contains('faq-tab')) return;
      document.querySelectorAll('.faq-tab').forEach(function(t) { t.classList.remove('active'); });
      e.target.classList.add('active');
      var rawSection = e.target.getAttribute('data-key') || '';
      // 英文模式下：中文tab名 → 英文section名
      if (currentLang === 'en') {
        var zhToEn = {
          '工厂实力与资质': 'Factory Strength & Credentials',
          '产品与定制服务': 'Products & Customization',
          '质量控制与测试': 'Quality Control & Testing',
          '生产与物流': 'Production & Logistics',
          '商务条款与合作': 'Business Terms & Cooperation',
          '出口服务与认证': 'Export Services & Certification',
          '市场信息与趋势': 'Market Insights & Trends',
          '合作流程与联系方式': 'Cooperation Process & Contact'
        };
        currentFilter = rawSection ? (zhToEn[rawSection] || rawSection) : '';
      } else {
        currentFilter = rawSection;
      }
      var groups = groupBySection(allFAQs, currentLang);
      document.getElementById('faqContent').innerHTML = renderFAQ(groups, currentFilter);
    });

    // ── Scroll highlight active tab ──────────────────────────────
    window.addEventListener('scroll', function() {
      var cards = document.querySelectorAll('.faq-card');
      cards.forEach(function(card) {
        var rect = card.getBoundingClientRect();
        if (rect.top < 200 && rect.bottom > 200) {
          var section = card.getAttribute('data-section');
          document.querySelectorAll('.faq-tab').forEach(function(t) {
            var tabKey = t.getAttribute('data-key') || '';
            if (currentLang === 'en') {
              var zhToEn = {
                '工厂实力与资质': 'Factory Strength & Credentials',
                '产品与定制服务': 'Products & Customization',
                '质量控制与测试': 'Quality Control & Testing',
                '生产与物流': 'Production & Logistics',
                '商务条款与合作': 'Business Terms & Cooperation',
                '出口服务与认证': 'Export Services & Certification',
                '市场信息与趋势': 'Market Insights & Trends',
                '合作流程与联系方式': 'Cooperation Process & Contact'
              };
              tabKey = zhToEn[tabKey] || tabKey;
            }
            t.classList.toggle('active', tabKey === section);
          });
        }
      });
    });

    // ── Init ────────────────────────────────────────────────────
    applyI18n();
    loadFAQs();
  </script>
</body>
</html>
