  <link rel="stylesheet" href="/styles.css">
  <style>
    body { padding-top: 80px; }

    /* Hero */
    .faq-hero {
      background: linear-gradient(135deg, #0d1117 0%, #1a2540 50%, #0d1117 100%);
      padding: 80px 0 70px;
      text-align: center;
      position: relative;
      overflow: hidden;
    }
    .faq-hero::before {
      content: '';
      position: absolute;
      top: -50%;
      left: -50%;
      width: 200%;
      height: 200%;
      background: radial-gradient(ellipse at center, rgba(255,107,53,0.06) 0%, transparent 60%);
      animation: faqPulse 8s ease-in-out infinite;
    }
    @keyframes faqPulse { 0%,100%{transform:scale(1);} 50%{transform:scale(1.1);} }
    .faq-hero-badge {
      display: inline-block;
      background: rgba(255,107,53,0.15);
      color: #FF6B35;
      font-size: 12px;
      letter-spacing: 3px;
      text-transform: uppercase;
      font-weight: 600;
      padding: 6px 16px;
      border-radius: 100px;
      border: 1px solid rgba(255,107,53,0.3);
      margin-bottom: 20px;
    }
    .faq-hero h1 { color: #fff; font-size: 48px; font-weight: 800; margin-bottom: 16px; line-height: 1.2; }
    .faq-hero p { color: #94a3b8; font-size: 18px; max-width: 600px; margin: 0 auto; }
    .faq-hero-stats {
      display: flex;
      justify-content: center;
      gap: 40px;
      margin-top: 40px;
    }
    .faq-hero-stat { text-align: center; }
    .faq-hero-stat .num { color: #FF6B35; font-size: 28px; font-weight: 800; }
    .faq-hero-stat .label { color: #64748b; font-size: 12px; margin-top: 4px; }

    /* Layout */
    .faq-container { max-width: 1200px; margin: 0 auto; padding: 60px 24px; }

    /* Tab bar */
    .faq-tabs {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin-bottom: 40px;
      background: #f8fafc;
      border-radius: 12px;
      padding: 8px;
    }
    .faq-tab {
      padding: 8px 16px;
      border-radius: 8px;
      border: none;
      background: transparent;
      color: #64748b;
      font-size: 14px;
      cursor: pointer;
      font-weight: 500;
      transition: all 0.2s;
      white-space: nowrap;
    }
    .faq-tab:hover { background: #fff; color: #1a1a2e; }
    .faq-tab.active { background: #fff; color: #FF6B35; font-weight: 700; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
    .nav-link.active { color: #FF6B35; font-weight: 600; }

    /* Section */
    .faq-section { margin-bottom: 8px; }
    .faq-section-header {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 8px;
      padding-bottom: 6px;
      border-bottom: 2px solid #FF6B35;
    }
    .faq-section-icon { font-size: 24px; }
    .faq-section-title { font-size: 22px; font-weight: 700; color: #1a1a2e; }

    /* FAQ items */
    .faq-card {
      border: 1px solid #e8eaf0;
      border-radius: 12px;
      margin-bottom: 6px;
      overflow: hidden;
      background: #fff;
      transition: box-shadow 0.3s;
    }
    .faq-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.06); }
    .faq-q {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 16px;
      padding: 18px 20px;
      cursor: pointer;
      font-weight: 600;
      font-size: 15px;
      color: #1a1a2e;
      background: #fff;
      transition: background 0.2s;
    }
    .faq-q:hover { background: #fafafa; }
    .faq-q .q-text { flex: 1; line-height: 1.5; }
    .faq-q .q-num {
      flex-shrink: 0;
      width: 32px;
      height: 32px;
      background: linear-gradient(135deg, #FF6B35, #ff8c5a);
      color: #fff;
      border-radius: 8px;
      font-size: 12px;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-top: 2px;
    }
    .faq-card.open .q-num { background: #1a1a2e; }
    .faq-q .q-toggle {
      flex-shrink: 0;
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: #f0f0f5;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      color: #FF6B35;
      font-weight: 300;
      margin-top: 2px;
      transition: transform 0.3s, background 0.2s;
    }
    .faq-card.open .q-toggle { transform: rotate(45deg); background: #FF6B35; color: #fff; }
    .faq-a {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.4s ease;
      background: #fafbfc;
      opacity: 0;
    }
    .faq-card.open .faq-a { max-height: 2000px; opacity: 1; }
    .faq-a-inner {
      padding: 0 20px 10px;
      font-size: 14px;
      line-height: 1.8;
      color: #4a5568;
      border-top: 1px solid #f0f0f5;
      padding-top: 12px;
      white-space: pre-line;
    }
    .faq-a-inner strong { color: #1a1a2e; }
    .faq-a-inner p { margin: 0 0 12px; }
    .faq-a-inner .faq-img { max-width: 100%; border-radius: 8px; margin: 12px 0; }

    /* CTA */
    .faq-cta-band {
      background: linear-gradient(135deg, #FF6B35, #ff8c5a);
      border-radius: 16px;
      padding: 48px;
      text-align: center;
      color: #fff;
      margin-top: 60px;
    }
    .faq-cta-band h2 { font-size: 28px; margin-bottom: 12px; }
    .faq-cta-band p { font-size: 16px; opacity: 0.9; margin-bottom: 24px; }
    .faq-cta-band .btn {
      display: inline-block;
      padding: 14px 32px;
      background: #fff;
      color: #FF6B35;
      border-radius: 8px;
      font-weight: 700;
      font-size: 16px;
      text-decoration: none;
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .faq-cta-band .btn:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,0.15); }

    /* Loading */
    .faq-loading { text-align: center; padding: 60px; color: #94a3b8; font-size: 16px; }
    .faq-loading::after { content: '...'; animation: faqDots 1.5s infinite; }
    @keyframes faqDots { 0%{content:'.';} 33%{content:'..';} 66%{content:'...';} }

    /* Mobile */
    @media (max-width: 768px) {
      .faq-hero h1 { font-size: 32px; }
      .faq-hero-stats { gap: 20px; }
      .faq-tabs { gap: 4px; }
      .faq-tab { padding: 6px 12px; font-size: 13px; }
      .faq-q { font-size: 14px; padding: 14px 16px; }
      .faq-a-inner { font-size: 13px; }
      .faq-cta-band { padding: 32px 24px; }
    }
  </style>
</head>
