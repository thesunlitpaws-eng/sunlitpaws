      <div class="logo-text">
        <span class="logo-en">sunlitpaws</span>
        <span class="logo-cn">河北炳临科技</span>
      </div>
    </a>

    <nav class="nav" id="nav">
      <a href="#home" class="nav-link active" data-i18n="nav.home"><%= t('nav.home', lang) %></a>
      <a href="#about" class="nav-link" data-i18n="nav.about"><%= t('nav.about', lang) %></a>
      
      <a href="#products" class="nav-link" data-i18n="nav.products"><%= t('nav.products', lang) %></a>
      <a href="#solutions" class="nav-link" data-i18n="nav.solutions"><%= t('nav.solutions', lang) %></a>
      <a href="#cases" class="nav-link" data-i18n="nav.cases"><%= t('nav.cases', lang) %></a>
      <a href="#news" class="nav-link" data-i18n="nav.news"><%= t('nav.news', lang) %></a>
      <a href="#faq" class="nav-link" data-i18n="nav.faq"><%= t('nav.faq', lang) %></a>
      <a href="#contact" class="nav-link" data-i18n="nav.contact"><%= t('nav.contact', lang) %></a>
    </nav>

    <div class="header-actions">
      <div class="lang-switcher" id="langSwitcher">
        <button class="lang-btn" id="langBtn">
          <span class="lang-flag">🌐</span>
          <span class="lang-current">EN</span>
          <svg width="12" height="12" viewBox="0 0 12 12"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round"/></svg>
        </button>
        <div class="lang-dropdown" id="langDropdown">
          <button class="lang-option active" data-lang="en">English</button>
          <button class="lang-option" data-lang="zh">中文</button>
        </div>
      </div>
      <button class="btn btn-primary" onclick="openInquiry()" data-i18n="nav.cta">Get Quote</button>
      <button class="hamburger" id="hamburger" aria-label="Menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<!-- ===== HERO ===== -->
<section class="hero" id="home">
  <div class="hero-slider" id="heroSlider"><% if (modules && modules.hero && modules.hero.slides) { %><% modules.hero.slides.forEach(function(slide, i) { %><div class="hero-slide<%= i === 0 ? ' active' : '' %>" style="<%= slide.image ? "background-image: url('" + slide.image + "')" : '' %>"><div class="slide-overlay"></div></div><% }); %><% } %></div>
  <div class="hero-dots" id="heroDots"><% if (modules && modules.hero && modules.hero.slides) { %><% modules.hero.slides.forEach(function(slide, i) { %><button class="hero-dot<%= i === 0 ? ' active' : '' %>" data-slide="<%= i %>"></button><% }); %><% } %></div>
  <button class="hero-arrow hero-arrow-left" id="heroPrev" aria-label="Previous slide">&#10094;</button>
  <button class="hero-arrow hero-arrow-right" id="heroNext" aria-label="Next slide">&#10095;</button>

  <div class="container hero-content">
    <h1 class="hero-title" data-i18n="hero.title"><%= (modules && modules.hero && modules.hero.title) ? modules.hero.title.replace(/\n/g, '<br>') : t('hero.title', lang).replace(/\n/g, '<br>') %></h1>
    <p class="hero-sub" data-i18n="hero.sub"><%= (modules && modules.hero && modules.hero.subtitle) ? modules.hero.subtitle : t('hero.sub', lang) %></p>
    <div class="hero-btns">
      <button class="btn btn-primary btn-lg" onclick="openInquiry()" data-i18n="hero.cta1"><%= t('hero.cta1', lang) %></button>
      <a href="#contact" class="btn btn-contact-prominent btn-lg" data-i18n="hero.cta2" style="text-decoration:none;"><%= t('hero.cta2', lang) %></a>
    </div>
    <div class="hero-stats">
      <% if (modules && modules.hero && modules.hero.stats) { %>
        <% modules.hero.stats.forEach(function(stat, i) { %>
          <% if (i > 0) { %><div class="hero-stat-divider"></div><% } %>
          <div class="hero-stat">
            <span class="stat-num"><%= stat.value %></span>
            <span class="stat-label"><%= stat.label %></span>
          </div>
        <% }); %>
      <% } else { %>
        <div class="hero-stat">
          <span class="stat-num">10+</span>
          <span class="stat-label" data-i18n="hero.stat1"><%= t('hero.stat1', lang) %></span>
        </div>
        <div class="hero-stat-divider"></div>
        <div class="hero-stat">
          <span class="stat-num">30+</span>
          <span class="stat-label" data-i18n="hero.stat2"><%= t('hero.stat2', lang) %></span>
        </div>
        <div class="hero-stat-divider"></div>
        <div class="hero-stat">
          <span class="stat-num">500+</span>
          <span class="stat-label" data-i18n="hero.stat3"><%= t('hero.stat3', lang) %></span>
        </div>
        <div class="hero-stat-divider"></div>
        <div class="hero-stat">
          <span class="stat-num">200+</span>
          <span class="stat-label">Global Partners</span>
        </div>
      <% } %>
    </div>
  </div>
</section>

