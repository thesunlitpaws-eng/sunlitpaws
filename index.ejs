    <div class="section-header reveal">
      <span class="section-tag" data-i18n="prod.tag"><%= t('prod.tag', lang) %></span>
      <h2 class="section-title" data-i18n="prod.title"><%= t('prod.title', lang) %></h2>
      <p class="section-sub" data-i18n="prod.sub"><%= t('prod.sub', lang) %></p>
    </div>

    <div class="prod-filter reveal">
      <button class="filter-btn active" data-cat="all" data-i18n="prod.filter.all"><%= t('prod.filter.all', lang) %></button>
      <div class="filter-dropdown" id="filterDropdown">
        <button class="filter-btn" data-cat="supplies" data-i18n="prod.filter.supplies"><%= t('prod.filter.supplies', lang) %> ▾</button>
        <div class="prod-subfilter" id="prodSubfilter">
          <button class="filter-btn sub" data-cat="bed" data-i18n="prod.sup.bed"><%= t('prod.sup.bed', lang) %></button>
          <button class="filter-btn sub" data-cat="cat-tree" data-i18n="prod.sup.catTree"><%= t('prod.sup.catTree', lang) %></button>
          <button class="filter-btn sub" data-cat="carrier" data-i18n="prod.sup.carrier"><%= t('prod.sup.carrier', lang) %></button>
          <button class="filter-btn sub" data-cat="stroller" data-i18n="prod.sup.stroller"><%= t('prod.sup.stroller', lang) %></button>
          <button class="filter-btn sub" data-cat="car-seat" data-i18n="prod.sup.carSeat"><%= t('prod.sup.carSeat', lang) %></button>
          <button class="filter-btn sub" data-cat="litter" data-i18n="prod.sup.litter"><%= t('prod.sup.litter', lang) %></button>
        </div>
      </div>
      <button class="filter-btn" data-cat="toys" data-i18n="prod.filter.toys"><%= t('prod.filter.toys', lang) %></button>
      <button class="filter-btn" data-cat="food" data-i18n="prod.filter.food"><%= t('prod.filter.food', lang) %></button>
    </div>

<div class="prod-grid" id="prodGrid">
<% products.forEach(function(p, i) { %>
<% var delay = i > 0 ? ' style="--delay:' + (i * 0.05) + 's"' : ''; %>
<% var img = (p.images && p.images.original) || p.image || 'https://images.unsplash.com/photo-1583337130417-3346a1be7dee?w=600&q=80'; %>
<% var name = (lang === 'en' && p.name_en) ? p.name_en : (p.name || ''); %>
<% var desc = (lang === 'en' && p.desc_en) ? p.desc_en : (p.desc || ''); %>
<% var badge = (lang === 'en' && p.badge_en) ? p.badge_en : (p.badge || ''); %>
<% var catSlug = p.category_slug || 'products'; %>
<% var subSlug = p.subcategory_slug || 'general'; %>
<% var typeSlug = p.type_slug || 'standard'; %>
<% var slug = p.slug || p.id; %>
<% var prodUrl = '/products/' + catSlug + '/' + subSlug + '/' + typeSlug + '/' + slug + '/'; %>
<div class="prod-card reveal"<%- delay %> data-cat="<%= p.category || 'supplies' %>">
  <div class="prod-img-wrap">
    <img src="<%= img %>" alt="<%= name %>" loading="lazy"
         onerror="this.src='https://images.unsplash.com/photo-1583337130417-3346a1be7dee?w=600&q=80'" />
    <div class="prod-overlay">
      <button class="btn btn-primary btn-sm" onclick="location.href='<%= prodUrl %>'">
        <%= lang === 'zh' ? '查看详情' : 'View Details' %>
      </button>
      <button class="btn btn-primary btn-sm" onclick="openInquiry()"
              style="background:#FF6B35;color:#fff;box-shadow:0 2px 8px rgba(255,107,53,0.4);">
        <%= lang === 'zh' ? '立即询价' : 'Inquire Now' %>
      </button>
    </div>
    <span class="prod-badge"><%= badge %></span>
  </div>
  <div class="prod-info">
    <h3><%= name %></h3>
    <p><%= desc %></p>
    <div class="prod-meta">
      <% if (p.moq) { %><span><%= lang === 'zh' ? '起订量: ' : 'MOQ: ' %><%= p.moq %></span><% } %>
      <button class="prod-cta" onclick="openInquiry()">
        <%= lang === 'zh' ? '获取报价' : 'Get Price' %>
      </button>
    </div>
  </div>
</div>
<% }); %>
    </div>
    <div id="prodPagination" class="prod-pagination"></div>
    <div class="prod-more" style="text-align:center; margin-top:2rem;">
      <p data-i18n="prod.more.text">500+ SKUs available across all categories</p>
      <button class="btn btn-primary" onclick="openInquiry()" data-i18n="prod.more.cta">Download Full Catalog</button>
    </div>
  </div>
</section>

