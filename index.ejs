</div>
<script>
// 动态加载 Factory 卡片数据
(function() {
  fetch('/api/modules')
    .then(function(r) { return r.json(); })
    .then(function(m) {
      var factory = m.factory;
      if (!factory || !factory.cards) return;
      // 更新标题和副标题（已由 loadHeroSlides / loadModules 处理，i18n 会生效）
      var grid = document.getElementById('factoryGrid');
      if (!grid) return;
      // 只更新图片，不替换整个内容，保持 data-i18n 属性
      var cards = document.querySelectorAll('.factory-card');
      factory.cards.forEach(function(c, i) {
        if (cards[i]) {
          var img = cards[i].querySelector('.factory-img');
          if (img && c.image) img.src = c.image;
        }
      });
    })
    .catch(function(e) { console.warn('Factory load failed', e); });
})();
</script>

