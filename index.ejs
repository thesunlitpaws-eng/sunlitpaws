      <button class="faq-tab" data-section="工厂实力与资质"><%= t('faq.tab.factory', lang) %></button>
      <button class="faq-tab" data-section="产品与定制服务"><%= t('faq.tab.product', lang) %></button>
      <button class="faq-tab" data-section="质量控制与测试"><%= t('faq.tab.quality', lang) %></button>
      <button class="faq-tab" data-section="生产与物流"><%= t('faq.tab.production', lang) %></button>
      <button class="faq-tab" data-section="商务条款与合作"><%= t('faq.tab.business', lang) %></button>
      <button class="faq-tab" data-section="出口服务与认证"><%= t('faq.tab.export', lang) %></button>
      <button class="faq-tab" data-section="合作流程与联系方式"><%= t('faq.tab.process', lang) %></button>
    </div>
    
    <!-- FAQ Content -->
    <div class="faq-content reveal" id="faqContent">
    </div>
    <!-- FAQ Pagination -->
    <div class="faq-pagination" id="faqPagination"></div>
  </div>
</section>

    <script>
    window.__SSR_LANG__ = '<%= lang %>';
    var allFAQs = <%- JSON.stringify(faqs) %>;
    var faqLoadedLang = '';
    var faqCurrentPage = 1;
    var faqItemsPerPage = 3;
    var faqCurrentList = []; // currently filtered FAQ list

    function getFAQLang() {
      var url = new URL(window.location.href);
      var fromUrl = url.searchParams.get('lang');
      if (fromUrl === 'zh' || fromUrl === 'en') return fromUrl;
      return window.__SSR_LANG__ || 'en';
    }

    function toggleFaq(el) {
      var card = el.closest('.faq-item');
      var wasOpen = el.classList.contains('open');
      document.querySelectorAll('.faq-q').forEach(q => q.classList.remove('open'));
      document.querySelectorAll('.faq-a').forEach(a => a.style.display = 'none');
      document.querySelectorAll('.faq-item.open').forEach(i => i.classList.remove('open'));
      if (!wasOpen) {
        el.classList.add('open');
        if (card) card.classList.add('open');
        el.nextElementSibling.style.display = 'block';
      }
    }

    function renderFAQs(faqs) {
      faqCurrentList = faqs;
      faqCurrentPage = 1;
      renderFAQPage();
    }

    function renderFAQPage() {
      var faqs = faqCurrentList;
      var el = document.getElementById('faqContent');
      var totalPages = Math.ceil(faqs.length / faqItemsPerPage);
      if (faqCurrentPage > totalPages) faqCurrentPage = totalPages || 1;
      var startIdx = (faqCurrentPage - 1) * faqItemsPerPage;
      var endIdx = startIdx + faqItemsPerPage;
      var pageFaqs = faqs.slice(startIdx, endIdx);

      if (!el || faqs.length === 0) {
        el.innerHTML = '<p style="text-align:center;color:#94a3b8;padding:40px;">' + 
          (getFAQLang() === 'zh' ? '暂无常见问题解答' : 'No FAQs available') + '</p>';
        document.getElementById('faqPagination').innerHTML = '';
        return;
      }
      var html = '';
      pageFaqs.forEach(function(faq, idx) {
        var num = String(startIdx + idx + 1).padStart(2, '0');
        html += '<div class="faq-item">';
        html += '<div class="faq-q" onclick="toggleFaq(this)">';
        var qText = (faq.question || '').replace(/<[^>]+>/g, '');
        html += '<span class="q-num">' + num + '</span>';
        html += '<span class="q-text">' + qText + '</span>';
        html += '<span class="faq-icon">+</span>';
        html += '</div>';
        html += '<div class="faq-a"><div class="faq-a-inner">' + (faq.answer || '') + '</div></div>';
        html += '</div>';
      });
      el.innerHTML = html;

      // Render pagination
      renderFAQPagination(totalPages);
    }

    function renderFAQPagination(totalPages) {
      var container = document.getElementById('faqPagination');
      if (!container) return;
      if (totalPages <= 1) { container.innerHTML = ''; return; }

      var html = '';
      // Prev arrow
      html += '<button class="page-btn arrow" ' + (faqCurrentPage === 1 ? 'disabled' : '') + ' onclick="faqGoToPage(' + (faqCurrentPage - 1) + ')">\u2039</button>';

      // Page numbers
      for (var i = 1; i <= totalPages; i++) {
        if (totalPages <= 7 || i === 1 || i === totalPages || Math.abs(i - faqCurrentPage) <= 1) {
          html += '<button class="page-btn' + (i === faqCurrentPage ? ' active' : '') + '" onclick="faqGoToPage(' + i + ')">' + i + '</button>';
        } else if (i === faqCurrentPage - 2 || i === faqCurrentPage + 2) {
          html += '<span class="page-btn" style="border:none;cursor:default;">\u2026</span>';
        }
      }

      // Next arrow
      html += '<button class="page-btn arrow" ' + (faqCurrentPage === totalPages ? 'disabled' : '') + ' onclick="faqGoToPage(' + (faqCurrentPage + 1) + ')">\u203A</button>';

      container.innerHTML = html;
    }

    function faqGoToPage(page) {
      var totalPages = Math.ceil(faqCurrentList.length / faqItemsPerPage);
      if (page < 1 || page > totalPages) return;
      faqCurrentPage = page;
      renderFAQPage();
      // Scroll to FAQ section top
      var section = document.getElementById('faq');
      if (section) section.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    // 中文分区名 → 英文分区名映射
    var ZH_TO_EN_SECTION = {
      '工厂实力与资质': 'Factory Strength & Credentials',
      '产品与定制服务': 'Products & Customization',
      '质量控制与测试': 'Quality Control & Testing',
      '生产与物流': 'Production & Logistics',
      '商务条款与合作': 'Business Terms & Cooperation',
      '出口服务与认证': 'Export Services & Certification',
      '市场信息与趋势': 'Market Insights & Trends',
      '合作流程与联系方式': 'Cooperation Process & Contact'
    };

    // Tab click
    document.querySelectorAll('.faq-tab').forEach(tab => {
      tab.addEventListener('click', function() {
        document.querySelectorAll('.faq-tab').forEach(t => t.classList.remove('active'));
        this.classList.add('active');
        var section = this.getAttribute('data-section');
        var lang = getFAQLang();
        var langFiltered = allFAQs.filter(f => f.lang === lang || (!f.lang && lang === 'en'));
        if (!section) {
          renderFAQs(langFiltered);
        } else {
          // 英文模式下，将中文tab的data-section映射为英文分区名
          var targetSection = (lang === 'en' && ZH_TO_EN_SECTION[section]) ? ZH_TO_EN_SECTION[section] : section;
          var filtered = langFiltered.filter(f => f.section === targetSection);
          renderFAQs(filtered);
        }
      });
    });

    // Listen for language changes and reload FAQs
    window.addEventListener('languageChanged', function(e) {
      faqLoadedLang = ''; // force reload
      loadFAQs();
    });

    // Init on load
    loadFAQs();
    function loadFAQs() {
      var lang = getFAQLang();
      if (faqLoadedLang === lang) {
        var filtered = allFAQs.filter(f => f.lang === lang || (!f.lang && lang === 'en'));
        renderFAQs(filtered);
        return;
      }
      document.getElementById('faqContent').innerHTML = '<div class="faq-loading">' + (lang === 'zh' ? '加载中...' : 'Loading...') + '</div>';
      var filtered = allFAQs.filter(f => f.lang === lang || (!f.lang && lang === 'en'));
      faqLoadedLang = lang;
      renderFAQs(filtered);
    }
    </script>
</section>
