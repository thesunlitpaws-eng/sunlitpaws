      </div>
    </div>
    <div class="factory-card" data-index="1">
      <div class="factory-img-wrap">
        <img src="https://images.unsplash.com/photo-1565793298595-6a879b1d9492?w=800&q=80" alt="Product Showroom" class="factory-img" loading="lazy">
        <div class="factory-overlay">
          <div class="factory-info">
            <span class="factory-num">02</span>
            <h3 class="factory-name" data-i18n="factory.card2.name"><%= t('factory.card2.name', lang) %></h3>
