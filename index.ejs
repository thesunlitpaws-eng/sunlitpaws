    <svg width="22" height="22" viewBox="0 0 22 22" fill="none"><path d="M11 2C6.03 2 2 5.58 2 10c0 2.1.9 4 2.4 5.4L3 20l4.8-1.4C9 19.5 10 19.8 11 19.8c4.97 0 9-3.58 9-8s-4.03-8-9-8z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M8 9.5c.5 1 1.5 2.5 3 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
    <span>WhatsApp</span>
  </a>
  <button class="float-btn float-top" id="backTop" onclick="window.scrollTo({top:0,behavior:'smooth'})" title="Back to top">
    <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M3 12l6-6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
</div>

<!-- ===== INQUIRY MODAL ===== -->
<div class="modal-overlay" id="inquiryModal" onclick="closeInquiry(event)">
  <div class="modal">
    <button class="modal-close" onclick="closeInquiry()">&times;</button>
    <div class="modal-header">
      <h3 data-i18n="modal.title"><%= t('modal.title', lang) %></h3>
      <p data-i18n="modal.sub"><%= t('modal.sub', lang) %></p>
    </div>
    <form class="modal-form" onsubmit="submitModalForm(event)">
      <div class="form-row">
        <div class="form-group">
          <label data-i18n="form.name"><%= t('form.name', lang) %></label>
          <input type="text" required placeholder="<%= t('form.name.ph', lang) %>" />
        </div>
        <div class="form-group">
          <label data-i18n="form.email"><%= t('form.email', lang) %></label>
          <input type="email" required placeholder="john@company.com" />
        </div>
      </div>
      <div class="form-group">
        <label data-i18n="form.company"><%= t('form.company', lang) %></label>
        <input type="text" required placeholder="<%= t('form.company.ph', lang) %>" />
      </div>
      <div class="form-group">
        <label data-i18n="form.message"><%= t('form.message', lang) %></label>
        <textarea rows="3" required placeholder="<%= t('form.message.ph', lang) %>"></textarea>
      </div>
      <button type="submit" class="btn btn-primary btn-full" data-i18n="form.submit"><%= t('form.submit', lang) %></button>
    </form>
  </div>
</div>

<!-- ===== SUCCESS TOAST ===== -->
<div class="toast" id="toast">
  <div class="toast-icon">✅</div>
  <div>
    <strong data-i18n="toast.title"><%= t('toast.title', lang) %></strong>
    <p data-i18n="toast.msg"><%= t('toast.msg', lang) %></p>
  </div>
</div>

<script src="app.js?v=20260425c"></script>


<script>
// ─── 页面加载 hash 导航修正（备用）──────────────────────
(function() {
  if (!location.hash) return;
  var target = document.querySelector(location.hash);
  if (!target) return;
  requestAnimationFrame(function() {
    requestAnimationFrame(function() {
      target.scrollIntoView({ block: 'start', behavior: 'instant' });
    });
  });
})();

// 表单提交函数
function submitForm(e) {
  e.preventDefault();
  var form = e.target;
  var fd = new FormData(form);
  var data = Object.fromEntries(fd);
  fetch('/api/contact', {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify(data)
  }).then(r => r.json()).then(d => {
    if (d.success) { showToast(); form.reset(); }
    else alert('提交失败');
  }).catch(() => alert('提交失败'));
}

function submitModalForm(e) {
  e.preventDefault();
  var form = e.target;
  var inputs = form.querySelectorAll('input, textarea, select');
  var data = {name:'',email:'',company:'',phone:'',product:'',message:''};
  inputs.forEach(function(i){ if(i.name==='name'||i.type==='text')data.name=i.value; else if(i.name==='email'||i.type==='email')data.email=i.value; else if(i.name==='company')data.company=i.value; else if(i.name==='phone')data.phone=i.value; else if(i.tagName==='SELECT')data.product=i.value; else if(i.tagName==='TEXTAREA')data.message=i.value; });
  fetch('/api/contact', {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify(data)
  }).then(r => r.json()).then(d => {
    if (d.success) { closeInquiry(); showToast(); form.reset(); }
    else alert('提交失败');
  }).catch(() => alert('提交失败'));
}

function showToast() {
  var t = document.getElementById('toast');
  if (t) { t.classList.add('show'); setTimeout(function(){t.classList.remove('show');}, 4000); }
}

// 轮播图已由 SSR 直接渲染，无需 JS 加载
function loadHeroSlides() {}

// ─── FAQ SECTION ───────────────────────────────────────
</script>
</body>
</html>
